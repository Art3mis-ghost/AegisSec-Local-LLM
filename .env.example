# AegisSec Local Workstation Configuration
# No cloud API keys are required — this app runs 100% locally and offline.

# Optional: Default Ollama endpoint for local LLM inference (Windows default: http://127.0.0.1:11434)
VITE_DEFAULT_OLLAMA_URL="http://127.0.0.1:11434"

# Optional: Default local SOCKS5/Tor proxy port
VITE_DEFAULT_PROXY_PORT="9050"
